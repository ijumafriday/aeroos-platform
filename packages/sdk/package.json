{
  "name": "@aeroos/sdk",
  "version": "0.50.0",
  "private": false,
  "description": "Typed AeroOS integration SDK for the stable v1 API and signed webhooks",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aeroos/contracts": "workspace:*",
    "@aeroos/signing": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
