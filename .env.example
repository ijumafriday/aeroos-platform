# For running the API or worker outside Docker (pnpm dev) against `pnpm infra:up`.
# Every setting has a development default; production values come from Kubernetes secrets.
DB_HOST=localhost
DB_PORT=5432
KAFKA_BROKERS=localhost:29092
TEMPORAL_ADDRESS=localhost:7233
OIDC_ISSUER=http://localhost:8081/realms/aeroos
OIDC_JWKS_URL=http://localhost:8081/realms/aeroos/protocol/openid-connect/certs
CERBOS_URL=http://localhost:3592
API_URL=http://localhost:3000
SIGNING_KEY_FILE=./.data/signing-key.pem
SEED_DEMO=true
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=aeroos
S3_SECRET_KEY=aeroos-dev-secret
SIGNING_PROVIDER=transit
TRANSIT_ADDR=http://localhost:8200
TRANSIT_TOKEN=aeroos-dev-root
STEP_UP_MAX_AGE_SECONDS=300
OTEL_ENABLED=false

# Background workload identity (worker/optimiser when run outside docker-compose)
OIDC_TOKEN_URL=http://localhost:8081/realms/aeroos/protocol/openid-connect/token
SERVICE_CLIENT_ID=aeroos-worker
SERVICE_CLIENT_SECRET=change-me

DB_PASSWORD_ENGINEERING_SVC=

# External operational-planning providers. Format OPERATOR=secret[,OPERATOR=secret]. Empty disables the endpoint.
OPS_PROVIDER_API_KEYS=
# External validated FRMS/fatigue model providers.
FRMS_PROVIDER_API_KEYS=
