# Rendered by the nginx image at container start (envsubst): OIDC settings are runtime
# configuration, so one web image serves any cloud, region or on-premises deployment.
# Cache policy by path. One server-level add_header list (nginx drops server-level headers in any location that has
# its own add_header, so no location sets headers: the security headers below reach every response).
map $uri $aeroos_cache {
  ~^/assets/            "public, immutable";
  /runtime-config.json  "no-store";
  ~^/(api|ws)/?         "";
  default               "no-cache";
}

server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;

  gzip on;
  gzip_types text/css application/javascript application/json image/svg+xml;

  add_header X-Content-Type-Options nosniff always;
  add_header X-Frame-Options DENY always;
  add_header Referrer-Policy strict-origin-when-cross-origin always;
  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
  add_header Cache-Control $aeroos_cache;
  add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
  add_header Cross-Origin-Opener-Policy same-origin always;
  # Enforcing CSP. Keep this synchronized with e2e/tests/zz-security.spec.ts.
  add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' ${OIDC_AUTHORITY}/; frame-src 'self' ${OIDC_AUTHORITY}/; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self' ${OIDC_AUTHORITY}/; frame-ancestors 'none'" always;

  location = /runtime-config.json {
    default_type application/json;
    return 200 '{"oidcAuthority":"${OIDC_AUTHORITY}","oidcClientId":"${OIDC_CLIENT_ID}"}';
  }

  location /ws {
    proxy_pass http://api:3000;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_read_timeout 1h;
  }

  location /api/ {
    proxy_pass http://api:3000;
    # the API sets its own security headers (for Kubernetes, where the ingress bypasses this nginx); here the
    # server-level set below applies instead, so hide the API's copies rather than send each header twice
    proxy_hide_header X-Content-Type-Options;
    proxy_hide_header X-Frame-Options;
    proxy_hide_header Referrer-Policy;
    proxy_hide_header Content-Security-Policy;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location /assets/ {
    expires 1y;
    try_files $uri =404;
  }

  location / {
    try_files $uri /index.html;
  }
}
