    "/v1/platform/migrations/{id}/rows": {
      "post": {
        "summary": "Stage migration rows",
        "description": "",
        "security": [
          {
            "oidc": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Validation error"
          },
          "403": {
            "description": "Forbidden"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MigrationRows"
              }
            }
          }
        }
      }
    },
    "/v1/platform/migrations/{id}/validate": {
      "post": {
        "summary": "Validate staged migration rows",
        "description": "",
        "security": [
          {
            "oidc": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Validation error"
          },
          "403": {
            "description": "Forbidden"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      }
    },
    "/v1/platform/migrations/{id}/apply": {
      "post": {
        "summary": "Apply a validated or resumable failed migration",
        "description": "",
