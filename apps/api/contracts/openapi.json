        ],
        "responses": {
          "200": {
            "description": "Known event types"
          }
        }
      }
    },
    "/v1/integrations/ops-planning/ofp": {
      "post": {
        "summary": "Ingest authoritative operational flight plan",
        "description": "Provider-authenticated OFP/performance package. The operator is derived from the integration key; the provider must have an EFFECTIVE approved AeroOS master-data revision, and the flight tail/ETD must match the current AeroOS flight.",
        "security": [
          {
            "providerApiKey": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OfpIngest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "OFP accepted with provenance hash"
          },
          "401": {
            "description": "Invalid provider key"
          },
          "422": {
            "description": "Flight/OFP mismatch"
          },
          "503": {
            "description": "Provider master data is not approved/effective"
          }
        }
      }
    },
    "/v1/integrations/frms/assessments": {
      "post": {
        "summary": "Ingest validated FRMS assessment",
        "description": "Provider-authenticated result from an externally validated fatigue-risk model. The exact provider/model/version must have an EFFECTIVE CREW master-data approval. AeroOS stores model/version/provenance and blocks roster publication for the latest CRITICAL assessment of an affected duty.",
        "security": [
          {
            "frmsApiKey": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FrmsIngest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Assessment accepted with provenance hash"
          },
          "401": {
            "description": "Invalid provider key"
          },
          "404": {
            "description": "Crew member not found"
          },
          "503": {
            "description": "FRMS provider/model/version is not approved/effective"
          }
        }
      }
    },
    "/v1/platform/integration-control/summary": {
      "get": {
        "operationId": "integrationControlSummary",
        "security": [
          {
            "oidc": []
          }
        ],
        "responses": {
          "200": {
            "description": "Integration/migration governance summary"
          }
        }
      }
    },
    "/v1/platform/integration-control/adapters": {
      "get": {
        "operationId": "listMigrationAdapterProfiles",
        "security": [
          {
            "oidc": []
          }
        ],
        "responses": {
          "200": {
            "description": "Versioned incumbent migration adapter profiles"
          }
        }
      }
    },
    "/v1/platform/integration-control/connectors": {
      "get": {
        "operationId": "listConnectorCatalog",
        "security": [
          {
            "oidc": []
