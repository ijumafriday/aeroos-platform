        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Validation error"
          },
          "403": {
            "description": "Forbidden"
          }
        }
      },
      "post": {
        "summary": "Create draft event rule",
        "description": "Rules can raise platform notifications only and cannot mutate regulated domain state.",
        "security": [
          {
            "oidc": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Validation error"
          },
          "403": {
            "description": "Forbidden"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RuleCreate"
              }
            }
          }
        }
      }
    },
    "/v1/platform/rules/{id}/executions": {
      "get": {
        "summary": "List rule execution history",
