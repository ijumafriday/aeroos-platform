{
  "realm": "aeroos",
  "displayName": "AeroOS",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "bruteForceProtected": true,
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 28800,
  "roles": {
    "realm": [
      {
        "name": "camo_engineer",
        "description": "Continuing airworthiness engineer"
      },
      {
        "name": "camo_manager",
        "description": "Continuing airworthiness manager (approves extensions)"
      },
      {
        "name": "certifying_staff",
        "description": "Part-145 certifying staff (B1/B2/C)"
      },
      {
        "name": "occ_controller",
        "description": "Operations control"
      },
      {
        "name": "flight_crew",
        "description": "Flight crew (EFB technical log)"
      },
      {
        "name": "auditor",
        "description": "Quality / compliance auditor"
      },
      {
        "name": "safety_manager",
        "description": "Safety Manager / SMS office (occurrence risk, investigation and safety action verification)"
      },
      {
        "name": "quality_manager",
        "description": "Part-145 quality manager (issues, suspends and revokes company authorisations)"
      },
      {
        "name": "storekeeper",
        "description": "Stores: receives and issues parts, controls tools"
      },
      {
        "name": "finance_controller",
        "description": "Finance: customers, invoicing, payments, general ledger, period close"
      },
      {
        "name": "service_worker",
        "description": "Trusted AeroOS background workload"
      },
      {
        "name": "platform_admin",
        "description": "Tenant platform administrator for integrations and platform configuration"
      },
      {
        "name": "engineering_engineer",
        "description": "Engineering configuration and technical engineering"
      },
      {
        "name": "engineering_manager",
        "description": "Engineering manager (independent configuration approval)"
      },
      {
        "name": "maintenance_planner",
        "description": "Part-145 maintenance planner / work-order controller"
      },
      {
        "name": "maintenance_supervisor",
        "description": "Part-145 production supervisor / shift controller"
      },
      {
        "name": "mechanic",
        "description": "Part-145 mechanic: executes and records work but does not certify CRS by role alone"
      },
      {
        "name": "tool_controller",
        "description": "Part-145 tool crib controller"
      },
      {
        "name": "records_officer",
        "description": "Technical Records officer"
      },
      {
        "name": "records_manager",
        "description": "Technical Records manager"
      }
    ]
  },
  "groups": [
    {
      "name": "NKX",
      "path": "/NKX",
      "attributes": {
        "operatorName": [
          "Nordkapp Air"
        ]
      }
    },
    {
      "name": "FJR",
      "path": "/FJR",
      "attributes": {
        "operatorName": [
          "Fjell Regional"
        ]
      }
    }
  ],
  "clients": [
    {
      "clientId": "aeroos-web",
      "name": "AeroOS web workspace",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:8080/*",
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "http://localhost:8080",
        "http://localhost:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8080/*##http://localhost:5173/*"
      },
      "protocolMappers": [
        {
          "name": "operators",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "operators",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "aeroos-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "auth-time",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usersessionmodel-note-mapper",
          "consentRequired": false,
          "config": {
            "user.session.note": "AUTH_TIME",
            "claim.name": "auth_time",
            "jsonType.label": "long",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "aeroos-worker",
      "name": "Aeroos Worker",
      "enabled": true,
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "secret": "dev-aeroos-worker-secret-change-me",
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "aeroos-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "aeroos-optimiser",
      "name": "Aeroos Optimiser",
      "enabled": true,
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "secret": "dev-aeroos-optimiser-secret-change-me",
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "aeroos-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
